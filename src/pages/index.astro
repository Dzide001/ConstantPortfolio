---
import Layout from "../layouts/Layout.astro";
import CategoryCarousel from "../components/CategoryCarousel.astro";
import { Image } from "astro:assets";
import landing from "../data/landing.json";
import { resolveImage, url } from "../lib/projects";
const photo = resolveImage(landing.photo);
const meta = photo.meta ? await photo.meta : undefined;
---
<Layout active="home" bodyClass="home">
  <section class="landing">
    <div class="landing-photo">
      {meta
        ? <Image src={meta} alt={landing.photoAlt} widths={[800, 1280, 1800, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
        : <img src={photo.src} alt={landing.photoAlt} loading="eager" />}
    </div>
    <div class="landing-card">
      <svg class="ornament" viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2">
        {[0, 45, 90, 135].map((r) => <ellipse cx="20" cy="20" rx="3.2" ry="15" transform={`rotate(${r} 20 20)`} />)}
        <circle cx="20" cy="20" r="2.2" />
      </svg>
      <h1>{landing.heading}</h1>
      <p>{landing.text}</p>
      <a class="landing-link" href={url("portfolio/")}>{landing.linkLabel} &rarr;</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="carousel-head">
        <div>
          <h2>Browse by category</h2>
          <p>Work organized across theatre, film &amp; video, game audio, and system design.</p>
        </div>
        <div class="carousel-nav" style="align-items:center;gap:18px;">
          <a class="view-link" href={url("portfolio/")}>See full portfolio &rarr;</a>
          <button class="carousel-nav-btn" data-scroll="home-cats" data-dir="-1" aria-label="Scroll left">&#8249;</button>
          <button class="carousel-nav-btn" data-scroll="home-cats" data-dir="1" aria-label="Scroll right">&#8250;</button>
        </div>
      </div>
      <CategoryCarousel id="home-cats" />
    </div>
  </section>
</Layout>
