---
import Layout from "../layouts/Layout.astro";
import { ABOUT, EXPERIENCE, SITE } from "../data/categories";
import { Image } from "astro:assets";
import { resolveImage, url } from "../lib/projects";
const head = resolveImage(ABOUT.headshot);
const headMeta = head.meta ? await head.meta : undefined;
---
<Layout title="About" active="about" description="MFA in Sound Design, Yale School of Drama. Experience, education, tools and contact details for Constant K. Dzah.">
  <section class="hero hero-sm">
    <div class="container">
      <div class="hero-eyebrow">About</div>
      <h1>{SITE.name}</h1>
      <p class="lead">{ABOUT.intro}</p>
    </div>
  </section>
  <section class="section">
    <div class="container about-grid">
      <div>
        {headMeta
          ? <Image class="headshot" src={headMeta} alt={`Portrait of ${SITE.name}`} widths={[400, 800]} sizes="(max-width: 780px) 100vw, 400px" />
          : <img class="headshot" src={head.src} alt={`Portrait of ${SITE.name}`} width="400" height="400" />}
        <h3 class="about-h">Education</h3>
        <ul class="skill-list">{ABOUT.education.map((e) => <li>{e}</li>)}</ul>
        <h3 class="about-h">Consoles &amp; Systems</h3>
        <ul class="skill-list">{ABOUT.consoles.map((c) => <li>{c}</li>)}</ul>
        <h3 class="about-h">Languages</h3>
        <ul class="skill-list">{ABOUT.languages.map((l) => <li>{l}</li>)}</ul>
      </div>
      <div>
        <h2>Experience</h2>
        <div class="timeline">
          {EXPERIENCE.map((e) => (
            <div class="timeline-item">
              <div class="role">{e.role}</div>
              <div class="venue">{e.venue}</div>
              <div class="years">{e.years}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="contact-card">
        <h2 style="margin-bottom:10px;">Work together</h2>
        <p>Have a show, film or system in mind? Send a message and I'll get back to you.</p>
        <a class="btn btn-primary" href={url("contact/")}>Get in touch</a>
      </div>
    </div>
  </section>
</Layout>
