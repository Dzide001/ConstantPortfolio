---
import Layout from "../layouts/Layout.astro";
import { CATEGORIES } from "../data/categories";
import { allProjects } from "../lib/projects";
const projects = await allProjects();
---
<Layout title="Admin" noindex>
<section class="section" style="padding-top:48px;">
  <div class="container">
    <div class="hero-eyebrow">Admin</div>
    <h1 style="margin-bottom:8px;">Manage projects</h1>
    <p style="max-width:640px;margin-bottom:32px;">
      This page isn't linked from the site's navigation — only people with a valid GitHub token for
      this repo can actually save anything. See the README for how to create a token.
    </p>

    <div class="admin-panel">
      <h2 style="font-size:1.1rem;">Setup (one-time)</h2>
      <p class="hint">
        Create a fine-grained GitHub token scoped to <em>only this repository</em>{" "}with
        <strong>Contents: Read and write</strong>{" "}permission at{" "}
        <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">github.com/settings/personal-access-tokens/new</a>,
        then paste it below. It's stored only in this browser (localStorage) and sent only to
        api.github.com.
      </p>
      <div class="form-grid">
        <div class="form-field">
          <label>GitHub username / org</label>
          <input type="text" id="set-owner" placeholder="e.g. cdzah">
        </div>
        <div class="form-field">
          <label>Repository name</label>
          <input type="text" id="set-repo" placeholder="e.g. cdzah.github.io">
        </div>
        <div class="form-field">
          <label>Branch</label>
          <input type="text" id="set-branch" placeholder="main">
        </div>
        <div class="form-field">
          <label>GitHub token</label>
          <input type="password" id="set-token" placeholder="github_pat_...">
        </div>
      </div>
      <button class="btn btn-primary btn-sm" id="save-settings">Save settings</button>
      <button class="btn btn-ghost btn-sm" id="clear-settings">Clear</button>
    </div>

    <div class="admin-panel">
      <h2 id="form-heading" style="font-size:1.1rem;">Add a project</h2>
      <form id="project-form">
        <div class="form-grid">
          <div class="form-field full">
            <label>Title</label>
            <input type="text" id="f-title" required>
          </div>
          <div class="form-field">
            <label>Category</label>
            <select id="f-category"></select>
          </div>
          <div class="form-field">
            <label>Role</label>
            <input type="text" id="f-role" placeholder="e.g. Sound Designer">
          </div>
          <div class="form-field">
            <label>Venue</label>
            <input type="text" id="f-venue">
          </div>
          <div class="form-field">
            <label>Year</label>
            <input type="text" id="f-year" placeholder="e.g. 2026 or 2024–present">
          </div>
          <div class="form-field full">
            <label>Director (optional)</label>
            <input type="text" id="f-director">
          </div>
          <div class="form-field full">
            <label>Personal note (optional)</label>
            <textarea id="f-note" placeholder="A short write-up or reflection on the project."></textarea>
          </div>
        </div>

        <div class="form-field full">
          <label>Photos</label>
          <ul class="chip-list" id="existing-gallery"></ul>
          <div class="file-drop" style="margin-top:8px;">
            <input type="file" id="f-gallery" accept="image/*" multiple>
          </div>
          <ul class="chip-list" id="new-gallery-preview"></ul>
        </div>

        <div class="form-field full">
          <label>Audio playlist</label>
          <ul class="chip-list" id="existing-tracks"></ul>
          <div class="file-drop" style="margin-top:8px;">
            <input type="file" id="f-audio" accept="audio/*" multiple>
          </div>
          <ul class="chip-list" id="new-audio-preview"></ul>
        </div>

        <div style="display:flex;gap:10px;margin-top:8px;">
          <button type="submit" class="btn btn-primary" id="save-project">Save project</button>
          <button type="button" class="btn btn-ghost" id="cancel-edit" style="display:none;">Cancel edit</button>
        </div>
        <div class="admin-status" id="admin-status"></div>
      </form>
    </div>

    <div class="admin-panel">
      <h2 style="font-size:1.1rem;">Existing projects</h2>
      <ul class="existing-list" id="existing-list"></ul>
    </div>
  </div>
</section>

<script is:inline define:vars={{ cats: CATEGORIES, projects }}>
  window.__CATEGORIES = cats;
  window.__PROJECTS = projects;
</script>
<script>
  import "../scripts/admin.js";
</script>
</Layout>
