rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in person can reach only their own list.
    match /users/{uid}/nodes/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.id == id
        && request.resource.data.updatedAt is number
        && request.resource.data.keys().size() <= 24
        && (
          request.resource.data.get('deleted', false) == true
          || (request.resource.data.title is string && request.resource.data.title.size() <= 500)
        );
    }
  }
}
